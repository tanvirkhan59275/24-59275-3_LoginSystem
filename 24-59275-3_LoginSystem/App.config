<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <connectionStrings>
    <!--
      Change Data Source to match your machine:
        - Local SQL Express:      .\SQLEXPRESS   or   localhost\SQLEXPRESS
        - LocalDB:                (localdb)\MSSQLLocalDB
        - Full SQL Server:        localhost   or the server name your lab gave you
      Initial Catalog must match the database created by Schema.sql.
    -->
    <add name="LoginDB"
         connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=24-59275-3_LoginDB;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
